---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import PageTabs from './PageTabs.astro';

const id = Astro.locals.starlightRoute.entry.id.replace(/\.mdx?$/, '');
const [lang, topic] = id.split('/');
const en = lang === 'en-us';
const topics: Record<string, string> = {
  markdown: 'Markdown',
  csharp: en ? 'C# Studies' : 'Estudos C#',
  dotnet: en ? '.NET Studies' : 'Estudos .NET',
  neovim: 'Neovim IDE',
  arch: 'Arch Linux',
  ai: 'AI',
};
const label = topics[topic];
const isTopicIntro = id === `${lang}/${topic}/intro`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const backLabel = isTopicIntro ? (en ? 'Home Page' : 'Página Inicial') : label;
const href = isTopicIntro ? `${base}/${lang}/initial-page/` : `${base}/${lang}/${topic}/intro/`;
const showBack = label && backLabel;
---

<PageTabs />
{showBack && (
  <a class="back-to-topic" href={href}>
    <span aria-hidden="true">←</span> {backLabel}
  </a>
)}
<Default><slot /></Default>

<style>
  .back-to-topic {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(74, 222, 128, 0.35);
    border-left: 4px solid #1ee882;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(30, 232, 130, 0.14), rgba(30, 232, 130, 0.04));
    color: #1ee882 !important;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .back-to-topic:hover {
    color: #86efac !important;
    border-color: #4ade80;
    background: linear-gradient(135deg, rgba(30, 232, 130, 0.24), rgba(30, 232, 130, 0.08));
  }
</style>
