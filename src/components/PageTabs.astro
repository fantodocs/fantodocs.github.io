---
type Link = { type: 'link'; label: string; href: string; isCurrent: boolean };
type Entry = Link | { type: 'group'; label: string; entries: Entry[] };

const sidebar = Astro.locals.starlightRoute.sidebar as Entry[];

function findTabs(entries: Entry[]): Link[] | null {
  for (const entry of entries) {
    if (entry.type === 'group') {
      const found = findTabs(entry.entries);
      if (found) return found;
    }
  }
  const links = entries.filter((e): e is Link => e.type === 'link');
  return links.some((l) => l.isCurrent) ? links : null;
}

const MAX_TABS = 3;
const all = findTabs(sidebar);
const pt = Astro.currentLocale !== 'en-us';
const t = pt
  ? { title: 'Páginas', more: 'mais', hint: '↑↓: navegar   Enter: abrir   Esc: cancelar', close: 'Fechar' }
  : { title: 'Pages', more: 'more', hint: '↑↓: navigate   Enter: open   Esc: cancel', close: 'Close' };

let visible: Link[] = all ?? [];
let hidden = 0;
if (all && all.length > MAX_TABS) {
  const current = all.find((l) => l.isCurrent)!;
  const firstThree = all.slice(0, MAX_TABS);
  visible = firstThree.includes(current) ? firstThree : [...all.slice(0, MAX_TABS - 1), current];
  hidden = all.length - visible.length;
}
---

{all && all.length > 1 && (
  <div class="page-tabs-wrap">
    <nav class="page-tabs" aria-label={t.title}>
      {visible.map((tab) => (
        <a href={tab.href} class:list={['page-tab', { current: tab.isCurrent }]} aria-current={tab.isCurrent ? 'page' : undefined}>
          {tab.label}
        </a>
      ))}
      {hidden > 0 && (
        <button type="button" class="page-tab tabs-more-btn" data-open-pages>
          +{hidden} {t.more}
        </button>
      )}
    </nav>

    {hidden > 0 && (
      <dialog class="pages-modal" data-pages-modal>
        <div class="pages-head">
          <span class="pages-title">{t.title}</span>
          <button type="button" class="pages-close" data-close-pages aria-label={t.close}>×</button>
        </div>
        <div class="pages-list">
          {all.map((tab) => (
            <a href={tab.href} class:list={['pages-item', { current: tab.isCurrent }]} aria-current={tab.isCurrent ? 'page' : undefined}>
              <span class="pages-arrow" aria-hidden="true">{tab.isCurrent ? '>' : ''}</span>
              <span class="pages-label">{tab.label}</span>
            </a>
          ))}
        </div>
        <div class="pages-hint">{t.hint}</div>
      </dialog>
    )}
  </div>
)}

<style>
  .page-tabs-wrap {
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }
  .page-tabs {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .page-tabs::-webkit-scrollbar { display: none; }
  .page-tab {
    flex-shrink: 0;
    padding: 0.5rem 1rem;
    margin-bottom: -1px;
    border: 1px solid transparent;
    border-radius: 8px 8px 0 0;
    background: transparent;
    color: #9ca3af;
    font: inherit;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .page-tab:hover { color: #e6edf3; }
  .page-tab.current {
    color: #1ee882;
    background: rgba(30, 232, 130, 0.06);
    border-color: var(--sl-color-hairline);
    border-bottom-color: var(--sl-color-bg);
  }
  .tabs-more-btn { color: #a78bfa; margin-left: auto; }
  .tabs-more-btn:hover { color: #c4b5fd; }

  .pages-modal {
    width: min(32rem, calc(100vw - 2rem));
    max-height: 85vh;
    padding: 0;
    border: 2px solid #4b5058;
    border-radius: 14px;
    background: #0d0d0d;
    color: #e6edf3;
    font-family: 'JetBrainsMonoNerd', monospace;
    overflow: hidden;
  }
  .pages-modal[open] { display: flex; flex-direction: column; }
  .pages-modal::backdrop { background: rgba(0, 0, 0, 0.7); }
  .pages-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.25rem 0.75rem;
    border-bottom: 1px solid #4b5058;
  }
  .pages-title { color: #6b7280; font-weight: 700; font-size: 1.05rem; letter-spacing: 0.04em; }
  .pages-close {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid #3a3f45;
    border-radius: 10px;
    background: transparent;
    color: #cfd6dc;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }
  .pages-close:hover { border-color: #1ee882; }
  .pages-list {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem 0.75rem;
  }
  .pages-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    color: #cfd6dc;
    font-size: 1rem;
    text-decoration: none;
  }
  .pages-arrow { width: 1ch; color: #f59e0b; }
  .pages-item:hover, .pages-item:focus-visible { background: rgba(255, 255, 255, 0.06); color: #ffffff; outline: none; }
  .pages-item:focus-visible .pages-arrow::before { content: '>'; }
  .pages-item.current { color: #60a5fa; }
  .pages-hint {
    padding: 0.75rem 1.25rem 1rem;
    border-top: 1px solid #4b5058;
    color: #6b7280;
    font-size: 0.8rem;
  }
  @media (max-width: 50rem) {
    .pages-hint { display: none; }
    .pages-item { min-height: 3.1rem; font-size: 1.05rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.page-tabs-wrap').forEach((wrap) => {
    const dialog = wrap.querySelector<HTMLDialogElement>('[data-pages-modal]');
    if (!dialog) return;
    wrap.querySelector('[data-open-pages]')?.addEventListener('click', () => {
      dialog.showModal();
      (dialog.querySelector('.pages-item.current') as HTMLElement | null)?.focus();
    });
    wrap.querySelector('[data-close-pages]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      e.preventDefault();
      const items = Array.from(dialog.querySelectorAll<HTMLElement>('.pages-item'));
      const i = items.indexOf(document.activeElement as HTMLElement);
      const next = e.key === 'ArrowDown' ? Math.min(i + 1, items.length - 1) : Math.max(i - 1, 0);
      items[next]?.focus();
    });
  });
</script>
